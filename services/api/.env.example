# Copy to services/api/.env only when you need manual configuration.
# scripts/dev.ps1 overrides live/auth flags and always starts the no-cloud walkthrough safely.

# Purpose: runtime safety boundary | Required: yes | Applies: mock + live
# Format: development|test|production | Safe local default: development
APP_ENVIRONMENT=development

# Purpose: select live IQ providers | Required: no | Applies: live only
# Format: true|false | Safe local default: false (all providers use deterministic synthetic data)
USE_LIVE_FOUNDRY=false
USE_LIVE_FABRIC=false
USE_LIVE_WORK=false
USE_LIVE_WEB=false

# Purpose: enable hosted answer agent / specialist narration | Required: no | Applies: live only
# Format: true|false | Safe local default: false
USE_LIVE_AGENT=false
USE_LIVE_SPECIALISTS=false

# Purpose: enable the grounded local specialist team | Required: no | Applies: mock + live
# Format: true|false | Safe local default: false
USE_MULTI_AGENT=false

# Purpose: bound grounded multi-agent deepening | Required: no | Applies: mock + live
# Format: non-negative integers | Safe local defaults: 1 depth, 2 leads
AGENT_MAX_DEPTH=1
AGENT_MAX_LEADS=2

# Purpose: browser origins allowed to call the API | Required: no | Applies: mock + live
# Format: comma-separated origins | Safe local default: Vite only
CORS_ORIGINS=http://localhost:5173

# Purpose: override the synthetic data root | Required: no | Applies: mock mode
# Format: relative or absolute directory path | Safe default: repository data/ directory
# DATA_DIR=../../data

# Purpose: validate delegated API bearer tokens | Required: live/production; not needed in mock mode
# Format: tenant GUID, API audience URI, and scope value | Safe defaults: nonfunctional placeholders
AZURE_TENANT_ID=your-tenant-id
API_AUDIENCE=api://your-api-client-id
API_REQUIRED_SCOPE=access_as_user
AUTH_HTTP_TIMEOUT_SECONDS=10

# Purpose: Azure AI Search-backed Foundry IQ / Web IQ | Required: when matching USE_LIVE_* is true
# Format: HTTPS endpoint, resource names, API version | Safe defaults: nonfunctional placeholders
SEARCH_ENDPOINT=https://your-search-service.example.invalid
FOUNDRY_KB_NAME=your-foundry-knowledge-base
WEB_KB_NAME=your-web-knowledge-base
SEARCH_API_VERSION=2026-05-01-preview

# Purpose: hosted Foundry agents and Fabric-native eligibility evaluator
# Required: live/production | Format: Foundry project HTTPS endpoint and agent resource names
# Safe defaults: nonfunctional placeholders
PROJECT_ENDPOINT=https://your-foundry-project.example.invalid
AGENT_NAME=your-hosted-agent
ELIGIBILITY_EVALUATOR_AGENT=your-eligibility-evaluator-agent
SPECIALIST_ELIGIBILITY_AGENT=your-eligibility-specialist-agent
SPECIALIST_RENAL_AGENT=your-renal-specialist-agent
SPECIALIST_GENOMICS_AGENT=your-genomics-specialist-agent
SPECIALIST_PROTOCOL_AGENT=your-protocol-specialist-agent
SPECIALIST_WORKFLOW_AGENT=your-workflow-specialist-agent
SPECIALIST_EVIDENCE_AGENT=your-evidence-specialist-agent
LIVE_SPECIALIST_ROLES=eligibility,renal_labs,genomics
SPECIALIST_TIMEOUT=90
MODEL_DEPLOYMENT=your-model-deployment

# Purpose: Fabric Data Agent coordinates | Required: live/production; not needed in mock mode
# Format: Fabric item GUIDs | Safe defaults: obvious nonfunctional placeholders
FABRIC_WORKSPACE_ID=your-fabric-workspace-id
FABRIC_DATA_AGENT_ID=your-fabric-data-agent-id
FABRIC_LAKEHOUSE_ID=your-fabric-lakehouse-id
FABRIC_ONTOLOGY_ID=your-fabric-ontology-id
FABRIC_ONTOLOGY_NAME=your-fabric-ontology-name

# Purpose: Fabric API audience | Required: no override in normal Azure public cloud
# Format: OAuth scope URI | Safe default: Microsoft first-party public constant
FABRIC_API_SCOPE=https://api.fabric.microsoft.com/.default

# Purpose: optional read-only Fabric capacity status chip | Required: no
# Applies: live only | Format: subscription GUID and Azure resource names
# Safe defaults: nonfunctional placeholders; omitted values return Unknown without contacting Azure
AZURE_SUBSCRIPTION_ID=your-subscription-id
FABRIC_CAPACITY_RG=your-resource-group
FABRIC_CAPACITY_NAME=your-fabric-capacity
FABRIC_ARM_API_VERSION=2023-11-01

# Purpose: Azure ARM token audience/endpoints | Required: no override in Azure public cloud
# Format: HTTPS URI | Safe defaults: Microsoft first-party public constants
ARM_SCOPE=https://management.azure.com/.default
ARM_ENDPOINT=https://management.azure.com

# Purpose: user-assigned managed identity used by the production API
# Required: production deployments using managed identity; not needed in mock mode
# Format: application/client GUID | Safe default: nonfunctional placeholder
AZURE_CLIENT_ID=your-managed-identity-client-id

# Purpose: Work IQ OBO client | Required: when USE_LIVE_WORK=true; not needed in mock mode
# Format: application GUID | Safe default: nonfunctional placeholder
WORK_IQ_CLIENT_ID=your-work-iq-client-id

# Purpose: Work IQ service endpoint/scope | Required: when USE_LIVE_WORK=true
# Format: HTTPS endpoint and OAuth scope | Safe defaults: Microsoft first-party public constants
WORK_IQ_ENDPOINT=https://workiq.svc.cloud.microsoft/a2a/
WORK_IQ_SCOPE=api://workiq.svc.cloud.microsoft/.default

# Purpose: production certificate source for Work IQ OBO | Required: production live Work IQ
# Format: Key Vault HTTPS URL and secret name | Safe defaults: nonfunctional placeholders
WORK_IQ_KEY_VAULT_URL=https://your-key-vault.example.invalid/
WORK_IQ_CLIENT_CERTIFICATE_SECRET_NAME=your-work-iq-certificate-secret

# Purpose: local Work IQ certificate material | Required: only for manual non-production live Work IQ
# Format: base64 PFX, thumbprint, and PEM public certificate
# Safe default: empty. These are secrets/server-only values; never expose them as VITE_* variables.
WORK_IQ_CLIENT_CERTIFICATE=
WORK_IQ_CLIENT_CERTIFICATE_THUMBPRINT=
WORK_IQ_CLIENT_PUBLIC_CERTIFICATE=

# Purpose: Work IQ network/cache tuning | Required: no | Applies: live Work IQ only
# Format: positive seconds, IANA timezone, integer UTC offset minutes | Safe defaults shown
WORK_IQ_CERTIFICATE_CACHE_SECONDS=300
WORK_IQ_CERTIFICATE_REFRESH_RETRY_SECONDS=30
WORK_IQ_TIMEOUT_SECONDS=60
WORK_IQ_TIMEZONE=America/Chicago
WORK_IQ_TIMEZONE_OFFSET_MINUTES=-300
