{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "value": "eastus2" },
    "tenantId": { "value": "${AZURE_TENANT_ID}" },
    "apiContainerImage": { "value": "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest" },
    "apiContainerPort": { "value": 8000 },
    "logAnalyticsName": { "value": "${LOG_ANALYTICS_NAME}" },
    "appInsightsName": { "value": "${APPLICATION_INSIGHTS_NAME}" },
    "containerAppsEnvironmentName": { "value": "${CONTAINER_APPS_ENVIRONMENT_NAME}" },
    "apiContainerAppName": { "value": "${API_CONTAINER_APP_NAME}" },
    "staticWebAppName": { "value": "${STATIC_WEB_APP_NAME}" },
    "managedIdentityName": { "value": "${MANAGED_IDENTITY_NAME}" },
    "existingSearchResourceGroupName": { "value": "${EXISTING_SEARCH_RESOURCE_GROUP_NAME}" },
    "existingSearchServiceName": { "value": "${EXISTING_SEARCH_SERVICE_NAME}" },
    "existingFoundryResourceGroupName": { "value": "${EXISTING_FOUNDRY_RESOURCE_GROUP_NAME}" },
    "existingFoundryAccountName": { "value": "${EXISTING_FOUNDRY_ACCOUNT_NAME}" },
    "foundryProjectName": { "value": "${FOUNDRY_PROJECT_NAME}" },
    "foundryKbName": { "value": "${FOUNDRY_KB_NAME}" },
    "webKbName": { "value": "${WEB_KB_NAME}" },
    "fabricWorkspaceId": { "value": "${FABRIC_WORKSPACE_ID}" },
    "fabricDataAgentId": { "value": "${FABRIC_DATA_AGENT_ID}" },
    "fabricCapacityResourceGroup": { "value": "${FABRIC_CAPACITY_RESOURCE_GROUP}" },
    "fabricCapacityName": { "value": "${FABRIC_CAPACITY_NAME}" },
    "eligibilityEvaluatorAgentName": { "value": "${ELIGIBILITY_EVALUATOR_AGENT}" },
    "specialistEligibilityAgentName": { "value": "${SPECIALIST_ELIGIBILITY_AGENT}" },
    "specialistRenalAgentName": { "value": "${SPECIALIST_RENAL_AGENT}" },
    "specialistGenomicsAgentName": { "value": "${SPECIALIST_GENOMICS_AGENT}" },
    "specialistProtocolAgentName": { "value": "${SPECIALIST_PROTOCOL_AGENT}" },
    "specialistWorkflowAgentName": { "value": "${SPECIALIST_WORKFLOW_AGENT}" },
    "specialistEvidenceAgentName": { "value": "${SPECIALIST_EVIDENCE_AGENT}" },
    "workIqClientId": { "value": "${WORK_IQ_CLIENT_ID}" },
    "useLiveWork": { "value": false },
    "useLiveSpecialists": { "value": false },
    "webClientId": { "value": "${WEB_CLIENT_ID}" },
    "apiAudience": { "value": "${API_AUDIENCE}" },
    "apiRequiredScope": { "value": "${API_REQUIRED_SCOPE}" },
    "webApiScope": { "value": "${WEB_API_SCOPE}" },
    "workIqClientCertificateSecretName": { "value": "${WORK_IQ_CLIENT_CERTIFICATE_SECRET_NAME}" }
  }
}
