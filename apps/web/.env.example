# Browser-visible values only. Every VITE_* value is bundled into client JavaScript.
# Never put client secrets, certificates, access tokens, Key Vault values, or server credentials here.

# Purpose: API origin | Required: no for local mock (Vite proxies /api); yes for split-host live UI
# Format: absolute http(s) origin without a trailing slash | Safe local default: empty
VITE_API_BASE_URL=

# Purpose: Microsoft Entra SPA sign-in | Required: live/production; not needed in local mock mode
# Format: tenant GUID, public SPA client GUID, and delegated API scope URI
# Safe local default: empty. Tenant/client IDs and scopes are public identifiers, never secrets.
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_API_SCOPE=

# Purpose: optional explicit MSAL redirect | Required: no
# Format: registered absolute browser URL | Safe default: current window origin
# VITE_REDIRECT_URI=http://localhost:5173
